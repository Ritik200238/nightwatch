# Copy to .env for docker compose. All optional.
# The language layer uses whichever of these is set. With neither, the desk answers
# from the rules and /health reports that rather than claiming a model is behind it.
ANTHROPIC_API_KEY=
BITGET_QWEN_API_KEY=
# auto (default), anthropic, or qwen. An explicit choice with no key is refused rather
# than silently falling through to the other one.
NIGHTWATCH_LLM_PROVIDER=auto
FRED_API_KEY=
NIGHTWATCH_CORS=*
NEXT_PUBLIC_API_URL=http://localhost:8000
